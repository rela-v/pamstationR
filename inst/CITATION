pkgVer <- function(pkg) {
    if (!exists("meta") || is.null(meta)) meta <- packageDescription(pkg)
    ver <- meta$Version
    paste0('https://github.com/rela-v/pamstationR/', pkg, ' - R package version ', ver)
}

c(

    bibentry(bibtype="manual",
        title = "pamstationR",
        author = personList(
            as.person("John Vergis")
        ),
        year = format(Sys.Date(), "%Y"),
        url = "http://www.bioconductor.org/packages/pamstationR",
        note = pkgVer('pamstationR'),
        doi = '10.18129/B9.bioc.pamstationR'
    )
)
